# API v1, NestJS 11. Multi-stage.
#
# Build context: the monorepo root, 06-app/theetiptop-contest.
#   docker build -f ../../05-workflow/docker/Dockerfile.api -t theetiptop/api:$TAG .
#
# Four stages, each existing for one reason:
#   deps    install once, cached on the lockfile alone
#   build   compile the API and generate the Prisma client
#   prune   pin the generated manifest to the versions the build actually resolved
#   runtime the image that ships, carrying no compiler and no dev dependency
#
# The brief requires 100% Docker. It also requires the pipeline to be defensible, which is
# why every COPY below is a named path rather than `COPY . .`, see the note on the deps
# stage.

# ---------------------------------------------------------------------------- deps
FROM node:24-alpine AS deps

WORKDIR /app

# Only the manifests, so this layer is invalidated by a dependency change and by nothing
# else. `COPY . .` here would rebuild the whole dependency tree on every source edit, which
# on a Jenkins agent means several minutes added to every single build.
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/admin/package.json ./apps/admin/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/
COPY packages/api-client/package.json ./packages/api-client/

# `npm ci` rather than `npm install`: it installs exactly the lockfile and fails if the two
# have drifted, which is the behaviour a reproducible build needs.
RUN npm ci --no-audit --no-fund

# --------------------------------------------------------------------------- build
FROM deps AS build

WORKDIR /app

# The source. `.dockerignore` keeps node_modules, .nx, .next and every .env out of the
# context, without it this COPY ships several hundred megabytes to the daemon.
COPY . .

# Prisma 7 generates a TypeScript client into apps/api/src/generated, and that directory is
# gitignored: it has to be produced here, before the compiler runs.
RUN npx prisma generate

# Nx builds the API and, through the project graph, the shared packages it depends on.
# `--skip-nx-cache` is deliberately absent: the agent mounts a persistent volume on
# .nx/cache (correction 3 of DECISIONS.md § 4 bis), so the cache is the point.
RUN npx nx build @theetiptop-contest/api

# --------------------------------------------------------------------------- prune
FROM build AS prune

WORKDIR /app

# `generatePackageJson: true` in apps/api/webpack.config.js already left a package.json
# next to the bundle, listing exactly the ~20 packages webpack kept external. This pins
# each of its ranges to the exact version the build stage resolved from the committed
# lockfile.
#
# The script's header documents the three install paths that were measured and rejected
# first, and the one limitation that remains. Short version: npm's workspace filters do not
# restrict `ci` or `prune` (both installed the whole 936 MB tree), and `nx prune`'s trimmed
# lockfile is inconsistent with its own manifest under Express 5.
RUN node tools/pin-runtime-deps.mjs apps/api/dist/package.json

# NOTE: stage order is load-bearing. `docker build` with no `--target` builds the LAST
# stage in the file, so `runtime` must stay at the bottom. Putting `migrate` after it
# made every plain build produce the migration image under the API tag, same size,
# same name, wrong contents, and nothing says so.

# ------------------------------------------------------------------------- migrate
#
# The image that applies the migrations. A one-shot job, pulled once per deployment and
# never part of what serves traffic.
#
# Why separate at all. The Prisma CLI drags in tooling production has no use for.
# measured on this project: @prisma/studio-core 43 MB, @prisma/dev 19 MB, @prisma/engines
# 24 MB, for a total of +375 MB on an image that was 483. Carrying a GUI and a dev server
# in every replica of a web API, permanently, to run one command at deploy time is the
# wrong trade.
#
# Why it cannot drift from the API, which is the usual objection to a second image. It is
# built from the SAME Dockerfile, in the SAME build, from the SAME `build` stage, and the
# pipeline tags both with the same commit. There is no path by which one can be rebuilt
# without the other.
#
#   docker build -f Dockerfile.api --target migrate -t …/theetiptop/migrate:$TAG .
#
# It carries the CLI INSTALLED, not fetched at deploy time. `npx prisma` would resolve the
# package over the network, and the `backend` network is `internal: true`, a container on
# it has no route to npm, and should not. More fundamentally, an artefact that still needs
# the internet to finish installing itself is not reproducible: deployed twice, it can
# resolve two different CLI versions against the same database.
FROM node:24-alpine AS migrate

RUN apk add --no-cache dumb-init

ENV NODE_ENV=production
WORKDIR /app

# Versions pinned to the lockfile, not to a range. A CLI ahead of @prisma/client can write
# a migration the running code cannot read.
#
# A manifest rather than `npm install prisma@7.10.1 …` on the command line, because this set
# needs an `overrides` block and there is no flag that carries one.
#
# `@prisma/config` depends on `effect` at an exact `3.20.0`, which carries CVE-2026-121707,
# a ReDoS in the regex compiled for `Schema.TemplateLiteral`, rated HIGH. The scan stage
# caught it on the migrate image and on nothing else: the CLI is the only place prisma's own
# dependencies reach an image, and the runtime stage has no CLI.
#
# Adding `effect@3.22.5` to the install list would not help. npm honours the exact pin and
# nests the vulnerable copy under @prisma/config, so the top-level one simply sits beside it.
# An override is the only thing that reaches a transitive exact pin. The same override is in
# the workspace package.json, so the CLI used locally and in CI resolves the same version.
COPY <<'MANIFEST' /app/package.json
{
  "name": "theetiptop-migrate",
  "private": true,
  "dependencies": {
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "dotenv": "18.0.10"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
MANIFEST

RUN npm install --no-package-lock --no-audit --no-fund \
 && npm cache clean --force

# The schema and the migrations come from the build stage, so they are byte-identical to
# the ones the API image was generated against.
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/prisma.config.ts ./prisma.config.ts

# npm removed from the runtime image.
#
# Every HIGH finding Trivy reported on this image came from npm's own bundled
# dependencies -- undici and brace-expansion inside
# /usr/local/lib/node_modules/npm -- and not from a single line of this project's code.
# The base image ships a package manager that the container never uses: dependencies are
# installed at build time, and the entrypoint is `node`.
#
# Removing it clears six HIGH vulnerabilities at once, shrinks the image, and takes a
# package manager out of a production container. A process that gets remote code
# execution can no longer install anything.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && rm -rf /root/.npm /home/node/.npm

USER node

ENTRYPOINT ["dumb-init", "--"]
# The local binary, never `npx`: npx falls back to the network when it cannot resolve
# locally, which on this network is a confusing timeout instead of a clear failure.
CMD ["./node_modules/.bin/prisma", "migrate", "deploy"]

# ------------------------------------------------------------------------- runtime
FROM node:24-alpine AS runtime

# `dumb-init` so SIGTERM reaches Node. Without an init process, PID 1 is Node itself and
# Docker's stop signal is delivered to a process that does not forward it, the container
# is then killed after the 10-second grace period, mid-request.
RUN apk add --no-cache dumb-init

ENV NODE_ENV=production
WORKDIR /app

COPY --from=prune /app/apps/api/dist/package.json ./package.json

# `--no-package-lock`: the manifest is pinned to exact versions, so there is no range left
# for a lockfile to resolve. `--omit=dev` is belt and braces, the generated manifest has
# no devDependencies to begin with.
RUN npm install --omit=dev --no-package-lock --no-audit --no-fund \
 && npm cache clean --force

COPY --from=prune /app/apps/api/dist/main.js ./main.js
# npm removed from the runtime image.
#
# Every HIGH finding Trivy reported on this image came from npm's own bundled
# dependencies -- undici and brace-expansion inside
# /usr/local/lib/node_modules/npm -- and not from a single line of this project's code.
# The base image ships a package manager that the container never uses: dependencies are
# installed at build time, and the entrypoint is `node`.
#
# Removing it clears six HIGH vulnerabilities at once, shrinks the image, and takes a
# package manager out of a production container. A process that gets remote code
# execution can no longer install anything.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && rm -rf /root/.npm /home/node/.npm


# The schema and migrations travel with the image, so the same artefact that serves traffic
# is the one that migrates the database. A separate migration image could drift from it.
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/prisma.config.ts ./prisma.config.ts
# Runs as the unprivileged user the base image already provides. A container that does not
# need root should not have it: a remote code execution then lands on a user that cannot
# write to the filesystem it runs from.
USER node

EXPOSE 3333

# Reports whether the process is actually serving, not merely running. Consumed by Docker,
# by the Prometheus probe and by the post-deploy gate of the Jenkins pipeline.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3333/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "main.js"]
