# Configuration template for a DEPLOYED environment (dev, preprod-QA, prod).
#
# Copy to .env.dev / .env.preprod / .env.prod on the target host, and fill in. These files
# are never committed: Jenkins writes them from its credential store at deploy time.
#
#   docker compose -f compose.prod.yml --env-file .env.prod -p theetiptop-prod up -d

# --- Identity of the environment -----------------------------------------------
COMPOSE_PROJECT_NAME=theetiptop-prod
REGISTRY=registry.wk-archi-o25a-15m-g1.fr
# The image tag the pipeline built. Never `latest` in prod: a tag that moves makes a
# rollback impossible, because there is nothing to roll back to.
IMAGE_TAG=

# Shared reverse-proxy network, created once per host.
EDGE_NETWORK=theetiptop-edge

# --- Public URLs ---------------------------------------------------------------
SITE_URL=https://dsp5-archi-o25a-15m-g1.fr
ADMIN_URL=https://admin.dsp5-archi-o25a-15m-g1.fr
API_URL=https://api.dsp5-archi-o25a-15m-g1.fr

# Parent domain of the three, with a leading dot. REQUIRED: without it the session cookie
# is host-only and every authenticated call from the site comes back 401.
COOKIE_DOMAIN=.dsp5-archi-o25a-15m-g1.fr

# --- Database ------------------------------------------------------------------
POSTGRES_USER=theetiptop
POSTGRES_PASSWORD=
POSTGRES_DB=theetiptop
# Host directory the backup job writes dumps into. Must be on a volume that is itself
# backed up: a dump sitting on the disk it protects against is not a backup.
BACKUP_DIR=/var/backups/theetiptop

# --- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=

# --- Authentication ------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# console.cloud.google.com — redirect URI: $API_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# developers.facebook.com — redirect URI: $API_URL/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Security ------------------------------------------------------------------
# openssl rand -hex 32. Changing it orphans every existing participation IP hash, so it is
# generated once per environment and never rotated casually.
IP_HASH_SALT=

# One key per consumer, so any single one can be revoked without cutting off the others.
# Format: name:key, comma separated.
POS_API_KEYS=
