# Back office: administrator dashboard and in-store employee screens. Next.js 16.
#
# Build context: the monorepo root, 06-app/theetiptop-contest.
#   docker build -f ../../05-workflow/docker/Dockerfile.admin \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.fr \
#     -t theetiptop/admin:$TAG .
#
# Identical in shape to Dockerfile.web, and a separate file rather than a shared one with a
# build argument. The two deploy to different hosts with different ingress rules — the back
# office is not reachable from the public internet — so keeping them separate means a change
# to one cannot silently alter the other.

FROM node:24-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/admin/package.json ./apps/admin/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/
COPY packages/api-client/package.json ./packages/api-client/

RUN npm ci --no-audit --no-fund

# --------------------------------------------------------------------------- build
FROM deps AS build

WORKDIR /app

ARG NEXT_PUBLIC_API_URL=http://localhost:3333
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

COPY . .

RUN npx prisma generate
RUN npx nx build @theetiptop-contest/admin

# ------------------------------------------------------------------------- runtime
FROM node:24-alpine AS runtime

RUN apk add --no-cache dumb-init

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

WORKDIR /app

COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build /app/apps/admin/public ./apps/admin/public

USER node

EXPOSE 3001

# `/connexion` rather than `/`: the root redirects to `/admin`, which redirects an
# anonymous caller to `/connexion`. Probing the login page directly is one hop and gives an
# unambiguous 200.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3001/connexion',r=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/admin/server.js"]
