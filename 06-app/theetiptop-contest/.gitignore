# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Environment - secrets are never committed, see .env.example
.env
.env.*
!.env*.example

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

.nx/polygraph

# Next.js
.next
out

# Generated Prisma client. Produced by `npm run db:generate` and by the Docker build
# stage; committing it would mean a 500-file diff on every schema change.
apps/*/src/generated/

# Test reports and artefacts. Jenkins archives them from the workspace, it does not read
# them from the repository.
reports/
test-results/
playwright-report/
.playwright/
