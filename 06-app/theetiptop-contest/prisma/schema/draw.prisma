// Grand prize draw: "a year of tea worth 360 EUR".
//
// Two constraints from the brief to honour to the letter:
//  1. "The draws will of course be performed by your application on the server side"
//     -> never client-side, never reproducible by a player.
//  2. "For the grand prize draw, the number of entries a customer has does not increase
//      their chances of winning"
//     -> the draw pool is the set of DISTINCT PARTICIPANTS, not the set of participations.
//
// The draw is performed under the supervision of Maître Arnaud Rick, bailiff: the seed
// and the fingerprint of the participant list are retained so the draw can be replayed
// and verified after the fact.

model Draw {
  id String @id @default(cuid())

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])

  executedAt DateTime @default(now())

  /// Number of distinct participants entered into the draw (SELECT DISTINCT userId).
  participantCount Int

  /// Pseudo-random generator seed, retained so the draw can be replayed before the bailiff.
  seed String

  /// SHA-256 fingerprint of the ordered participant list at draw time: proves the pool
  /// was not altered afterwards.
  participantsFingerprint String @db.Char(64)

  winnerId String?
  winner   User?   @relation("drawWinner", fields: [winnerId], references: [id])

  bailiffName  String?
  affidavitUrl String?

  @@index([contestId, executedAt])
  @@index([winnerId])
}
