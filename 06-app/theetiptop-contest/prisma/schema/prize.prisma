// Prize catalogue.
//
// Distribution mandated by the brief over the 500,000 codes (100% winning tickets):
//   60% tea infuser                              -> 300,000
//   20% 100g box of detox tea or herbal infusion -> 100,000
//   10% 100g box of signature tea                ->  50,000
//    6% discovery box worth 39 EUR               ->  30,000
//    4% discovery box worth 69 EUR               ->  20,000
// Plus, outside the codes: one grand prize, a year of tea (360 EUR), drawn at closing.

model Prize {
  id          String    @id @default(cuid())
  label       String
  description String?
  type        PrizeType @default(TICKET_PRIZE)

  /// Commercial value in cents, which avoids any floating-point drift in statistics.
  valueCents Int

  /// Target share of the distribution, e.g. 60.00 for the tea infuser.
  /// Null for GRAND_PRIZE, which is not attached to any code.
  targetPercentage Decimal? @db.Decimal(5, 2)

  /// Number of codes to generate for this prize = targetPercentage x plannedCodeCount.
  /// Deliberate denormalisation: this is the reference value the automated conformity
  /// test counts the database against once generation has run.
  targetQuantity Int?

  /// Display order on the "prizes to win" page.
  rank Int @default(0)

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])

  codes TicketCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestId, label])
  @@index([contestId, type])
  @@index([rank])
}
