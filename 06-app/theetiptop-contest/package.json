{
  "name": "@theetiptop-contest/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:infra": "docker compose -f ../../05-workflow/docker/compose.dev.yml --env-file .env up -d",
    "dev:infra:down": "docker compose -f ../../05-workflow/docker/compose.dev.yml down",
    "dev:api": "nx serve @theetiptop-contest/api",
    "dev:web": "nx dev @theetiptop-contest/web",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "codes:generate": "tsx prisma/generate-codes.ts",
    "codes:verify": "tsx prisma/verify-codes.ts",
    "codes:reset": "tsx prisma/reset-codes.ts",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "build": "nx run-many -t build",
    "dev:admin": "nx dev @theetiptop-contest/admin --port=3001",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "k6 run tests/performance/participation.k6.js"
  },
  "private": true,
  "dependencies": {},
