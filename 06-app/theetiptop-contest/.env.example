# Configuration template. Copy to `.env` and fill in.
# `.env` is NEVER committed (see .gitignore) and NEVER baked into a Docker image
# (see .dockerignore): secrets are injected by Jenkins at runtime.

# --- Database ------------------------------------------------------------------
# Host port 5434: 5432 and 5433 are already taken by other projects on this machine.
POSTGRES_USER=theetiptop
POSTGRES_PASSWORD=theetiptop
POSTGRES_DB=theetiptop
POSTGRES_PORT=5434
DATABASE_URL="postgresql://theetiptop:theetiptop@localhost:5434/theetiptop?schema=public"

# --- Redis ---------------------------------------------------------------------
REDIS_PORT=6381
REDIS_URL="redis://localhost:6381"

# --- API -----------------------------------------------------------------------
API_PORT=3333
# NODE_ENV is set by the runtime: `next build` sets production, `nx serve` development.
# Declaring it here only makes Next warn about a non-standard value on every build.
# CORS origins: the public site and the back office.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Authentication (Better Auth) ----------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# Parent domain the session cookie is scoped to, with a leading dot, e.g.
# `.dsp5-archi-o25a-15m-g1.fr`. LEAVE EMPTY IN DEVELOPMENT: everything runs on localhost,
# and a cookie is scoped by host rather than by port, so the three ports already share it.
# It becomes REQUIRED once the API, the site and the back office are on three subdomains:
# without it the cookie is host-only and every call from the site comes back 401.
COOKIE_DOMAIN=

# Google OAuth - console.cloud.google.com
# Redirect URI: http://localhost:3333/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth - developers.facebook.com
# Redirect URI: http://localhost:3333/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Security ------------------------------------------------------------------
# Salt used to hash participation IP addresses (GDPR: never store an IP in clear).
# Generate with: openssl rand -hex 32
IP_HASH_SALT=

# API keys for the non-browser consumers of API v1.
# Format: name:key, comma separated. One distinct key per consumer, so any single key can
# be revoked without cutting off the others.
POS_API_KEYS="caisses-magasin:dev-key-caisses,e-commerce:dev-key-ecommerce"

# --- Front ends: server-side vs browser-side API address -----------------------
NEXT_PUBLIC_API_URL=http://localhost:3333
# API_URL is what the Next.js SERVER uses. Inside Docker that is the compose service
# name, which a browser cannot resolve.
# NEXT_PUBLIC_API_URL is the public address, baked into the client bundle at build time.
# Collapsing the two would mean either the server routing every call out through the
# public reverse proxy and back, or the browser being handed a Docker-internal hostname.
API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Printed on receipts next to the code, by the till endpoints.
PUBLIC_SITE_URL=http://localhost:3000
